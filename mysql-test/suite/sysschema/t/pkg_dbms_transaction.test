-- source include/not_embedded.inc
-- source include/have_innodb.inc
-- source include/have_perfschema.inc

--echo #
--echo # MDEV-34329: System package SYS.DBMS_TRANSACTION
--echo #

SET sql_mode= oracle;
CREATE TABLE t1 (a INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1);

--echo #
--echo # Test COMMIT
--echo #
START TRANSACTION;
UPDATE t1 SET a = 2;
CALL sys.DBMS_TRANSACTION.COMMIT;
SELECT @@session.in_transaction;
SELECT a FROM t1;

--echo #
--echo # Test COMMIT with no transaction
--echo #
CALL sys.DBMS_TRANSACTION.COMMIT;

--echo #
--echo # Commit should fail within a stored function
--echo #
DELIMITER $$;

CREATE FUNCTION f1() RETURN INT AS
BEGIN
  CALL sys.DBMS_TRANSACTION.COMMIT;
  RETURN 1;
END;
$$
DELIMITER ;$$

--error ER_COMMIT_NOT_ALLOWED_IN_SF_OR_TRG
SELECT f1();
DROP FUNCTION f1;

--echo #
--echo # Commit should succeed within a stored procedure
--echo #
DELIMITER $$;
CREATE PROCEDURE p1() AS
BEGIN
  CALL sys.DBMS_TRANSACTION.COMMIT;
END;
$$
DELIMITER ;$$

CALL p1();
DROP PROCEDURE p1;

--echo #
--echo # Test ROLLBACK
--echo #
START TRANSACTION;
UPDATE t1 SET a = 3;
CALL sys.DBMS_TRANSACTION.ROLLBACK;
SELECT @@session.in_transaction;
SELECT a FROM t1;

--echo #
--echo # Test ROLLBACK with no transaction
--echo #
CALL sys.DBMS_TRANSACTION.ROLLBACK;

--echo #
--echo # Rollback should fail within a stored function
--echo #
DELIMITER $$;

CREATE FUNCTION f1() RETURN INT AS
BEGIN
  CALL sys.DBMS_TRANSACTION.ROLLBACK;
  RETURN 1;
END;
$$
DELIMITER ;$$

--error ER_COMMIT_NOT_ALLOWED_IN_SF_OR_TRG
SELECT f1();
DROP FUNCTION f1;

--echo #
--echo # Rollback should succeed within a stored procedure
--echo #
DELIMITER $$;
CREATE PROCEDURE p1() AS
BEGIN
  CALL sys.DBMS_TRANSACTION.ROLLBACK;
END;
$$
DELIMITER ;$$

CALL p1();
DROP PROCEDURE p1;

DROP TABLE t1;

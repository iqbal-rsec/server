#
# Public variables cannot be initialized with the same
# package's function
#
CREATE OR REPLACE PACKAGE pkg1
AS
m_count INT:= init_count();
FUNCTION init_count RETURN INT;
FUNCTION get_count RETURN INT;
END;
$$
CREATE PACKAGE BODY pkg1
AS
FUNCTION init_count RETURN INT
AS
BEGIN
RETURN 1;
END;
FUNCTION get_count RETURN INT
AS
BEGIN
m_count:= m_count + 1;
RETURN m_count;
END;
END;

#
# MDEV-16482: Add support for SYNONYM for tables, views, sequences,
# functions, procedures and packages in Oracle mode
#
SET sql_mode=oracle;
CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (1), (2), (3);
CREATE TABLE t3 (b INT);
INSERT INTO t3 VALUES (7), (8), (9);
#
# Create a SYNONYM for a table
#
CREATE SYNONYM syn_t1 FOR t1;
#
# Select using the SYNONYM
#
SELECT syn_t1.a FROM syn_t1 WHERE syn_t1.a = 2;
a
2
SELECT test.syn_t1.a FROM test.syn_t1 WHERE test.syn_t1.a = 2;
a
2
#
# CREATE OR REPLACE SYNONYM
#
CREATE OR REPLACE SYNONYM syn_t1 FOR t2;
SELECT syn_t1.a FROM syn_t1 WHERE syn_t1.a = 2;
ERROR 42S02: Table 'test.t2' doesn't exist
#
# DROP SYNONYM
#
DROP SYNONYM IF EXISTS syn_t1;
DROP SYNONYM syn_t1;
ERROR 42000: SYNONYM test.syn_t1 does not exist
DROP SYNONYM IF EXISTS syn_t1;
Warnings:
Note	1305	SYNONYM test.syn_t1 does not exist
CREATE SYNONYM syn_t1 FOR t1;
CREATE VIEW v1 AS SELECT * FROM t1;
CREATE VIEW v2 AS SELECT * FROM syn_t1;
#
# Create a SYNONYM for a VIEW
#
CREATE SYNONYM syn_v1 FOR v1;
#
# Select using the SYNONYM
#
SELECT syn_v1.a FROM syn_v1 WHERE syn_v1.a = 2;
a
2
SELECT test.syn_v1.a FROM test.syn_v1 WHERE test.syn_v1.a = 2;
a
2
SELECT * FROM v2 WHERE v2.a = 2;
a
2
CREATE SEQUENCE seq START WITH 100 INCREMENT BY 10;
#
# Create a SYNONYM for a SEQUENCE
#
CREATE SYNONYM syn_seq FOR seq;
#
# Operate on the sequence using the SYNONYM
#
SELECT syn_seq.NEXTVAL FROM DUAL;
syn_seq.NEXTVAL
100
CREATE FUNCTION f1 RETURN INT AS
BEGIN
RETURN 1;
END;
$$
#
# Create a SYNONYM for a stored FUNCTION
#
CREATE SYNONYM syn_f1 FOR f1;
#
# Execute the FUNCTION using the SYNONYM
#
SELECT syn_f1() FROM DUAL;
syn_f1()
1
SELECT test.syn_f1() FROM DUAL;
test.syn_f1()
1
CREATE PROCEDURE p1 AS
BEGIN
NULL;
END;
$$
#
# Create a SYNONYM for a stored PROCEDURE
#
CREATE SYNONYM syn_p1 FOR p1;
#
# Execute the PROCEDURE using the SYNONYM
#
CALL syn_p1();
CALL test.syn_p1();
CREATE PACKAGE pkg1 AS
FUNCTION f1 RETURN INT;
PROCEDURE p1;
END;
$$
CREATE PACKAGE BODY pkg1 AS
FUNCTION f1 RETURN INT AS
BEGIN
RETURN 1;
END;
PROCEDURE p1 AS
BEGIN
NULL;
END;
END;
$$
#
# Create a SYNONYM for a PACKAGE
#
CREATE SYNONYM syn_pkg1 FOR pkg1;
#
# Execute the PACKAGE's routines using the SYNONYM
#
SELECT syn_pkg1.f1() FROM DUAL;
syn_pkg1.f1()
1
SELECT test.syn_pkg1.f1() FROM DUAL;
test.syn_pkg1.f1()
1
CALL syn_pkg1.p1();
CALL test.syn_pkg1.p1();
#
# Create a SYNONYM for a PACKAGE's object
# Not supported in Oracle too
#
CREATE SYNONYM syn_pkg1_f1 FOR test.pkg1.f1;
ERROR 42000: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near '.f1' at line 1
CREATE SYNONYM syn_pkg1_f1 FOR pkg1.f1;
# TODO, should fail with ER_SP_DOES_NOT_EXIST
SELECT syn_pkg1_f1() FROM DUAL;
syn_pkg1_f1()
1
#
# Create a SYNONYM for a SYNONYM
#
CREATE SYNONYM syn_syn_t1 FOR syn_t1;
SELECT * FROM syn_syn_t1;
a
1
2
3
#
# Create a cyclic SYNONYM
#
CREATE SYNONYM syn_a FOR syn_b;
CREATE SYNONYM syn_b FOR syn_a;
SELECT * FROM syn_a;
ERROR HY000: SYNONYM 'test.syn_a' is cyclical
SELECT * FROM syn_b;
ERROR HY000: SYNONYM 'test.syn_b' is cyclical
CREATE SYNONYM syn_d FOR test.syn_d;
ERROR HY000: SYNONYM 'test.syn_d' is cyclical
CREATE SYNONYM test.syn_d FOR test.syn_d;
ERROR HY000: SYNONYM 'test.syn_d' is cyclical
CREATE SYNONYM syn_d FOR syn_d;
ERROR HY000: SYNONYM 'test.syn_d' is cyclical
#
# PUBLIC SYNONYM
#
CREATE PUBLIC SYNONYM syn_pub_t1 FOR t1;
SELECT * FROM syn_pub_t1;
a
1
2
3
CREATE PUBLIC SYNONYM syn_pub_f1 FOR f1;
SELECT syn_pub_f1() FROM DUAL;
syn_pub_f1()
1
CREATE PUBLIC SYNONYM syn_pub_p1 FOR p1;
CALL syn_pub_p1();
CREATE PUBLIC SYNONYM syn_pub_pkg1 FOR pkg1;
SELECT syn_pub_pkg1.f1() FROM DUAL;
syn_pub_pkg1.f1()
1
CALL syn_pub_pkg1.p1();
#
# Create a PUBLIC SYNONYM using an existing name
#
CREATE PUBLIC SYNONYM syn_pub_t1 FOR t3;
ERROR 42000: SYNONYM syn_pub_t1 already exists
#
# REPLACE PUBLIC SYNONYM
#
CREATE OR REPLACE PUBLIC SYNONYM syn_pub_t1 FOR t3;
#
# Drop PUBLIC SYNONYM, qualified with schema
#
DROP PUBLIC SYNONYM test.syn_pub_t1;
ERROR HY000: PUBLIC SYNONYM must not be qualified
#
# CREATE PUBLIC SYNONYM, qualified with schema
#
CREATE PUBLIC SYNONYM test.syn_pub_t1 FOR t1;
ERROR HY000: PUBLIC SYNONYM must not be qualified
CREATE USER testuser;
CREATE DATABASE db1;
GRANT ALL ON db1.* TO testuser;
GRANT CREATE PUBLIC SYNONYM ON *.* TO testuser;
connect con2, localhost, testuser;
connection con2;
USE db1;
SET sql_mode=oracle;
CREATE TABLE t2 (a INT);
INSERT INTO t2 VALUES (4), (5), (6);
CREATE SYNONYM syn_t2 FOR db1.t2;
SELECT * FROM syn_t2;
a
4
5
6
CREATE PUBLIC SYNONYM syn_pub_t2 FOR db1.t2;
#
# Create a SYNONYM for a table in another database
# which the user does not has access
#
CREATE SYNONYM syn_t1 FOR test.t1;
SELECT * FROM syn_t1;
ERROR 42000: SELECT command denied to user 'testuser'@'localhost' for table `test`.`t1`
SELECT * FROM test.syn_t1;
ERROR 42000: SELECT command denied to user 'testuser'@'localhost' for table `test`.`t1`
connection default;
USE test;
SELECT * FROM db1.syn_t1;
a
1
2
3
SELECT * FROM db1.t2;
a
4
5
6
SELECT * FROM db1.syn_t2;
a
4
5
6
#
# Create a SYNONYM for a table in another database
# which the user has access
#
CREATE SYNONYM syn_t2 FOR db1.t2;
SELECT * FROM syn_t2;
a
4
5
6
#
# Use a PUBLIC synonym created by another USER
#
SELECT * FROM syn_pub_t2;
a
4
5
6
#
# REVOKE PUBLIC SYNONYM privilege
#
REVOKE CREATE PUBLIC SYNONYM ON *.* FROM testuser;
disconnect con2;
connect con2, localhost, testuser;
connection con2;
USE db1;
SET sql_mode=oracle;
#
# CREATE public SYNONYM without privilege
#
CREATE PUBLIC SYNONYM syn_pub_t2 FOR db1.t2;
ERROR 28000: Access denied for user 'testuser'@'%' (using password: NO)
#
# DROP public SYNONYM without privilege
#
DROP PUBLIC SYNONYM syn_pub_t1;
ERROR 28000: Access denied for user 'testuser'@'%' (using password: NO)
#
# REPLACE public SYNONYM without privilege
#
CREATE OR REPLACE PUBLIC SYNONYM syn_pub_t1 FOR db1.t1;
ERROR 28000: Access denied for user 'testuser'@'%' (using password: NO)
connection default;
disconnect con2;
#
# REVOKE ALTER SYNONYM privilege
#
REVOKE ALTER SYNONYM ON db1.* FROM testuser;
connect con2, localhost, testuser;
connection con2;
USE db1;
SET sql_mode=oracle;
#
# DROP SYNONYM without privilege
#
DROP SYNONYM syn_t2;
ERROR 42000: Access denied for user 'testuser'@'%' to database 'db1'
#
# REPLACE SYNONYM without privilege
#
CREATE OR REPLACE SYNONYM syn_t2 FOR t2;
ERROR 42000: Access denied for user 'testuser'@'%' to database 'db1'
connection default;

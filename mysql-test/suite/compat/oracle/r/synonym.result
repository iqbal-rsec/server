#
# Create synonym for a non-existing object, and then create the object
#
CREATE SYNONYM syn_t4 FOR t4;
SELECT * FROM syn_t4;
ERROR 42S02: Table 'test.t4' doesn't exist
CREATE TABLE t4 (a INT);
INSERT INTO syn_t4 VALUES (10), (11), (12);
SELECT * FROM syn_t4;
a
10
11
12

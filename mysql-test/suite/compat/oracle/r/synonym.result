#
# Create synonym from within routines
# In Oracle, this is not allowed
#
CREATE PROCEDURE p2 AS
BEGIN
CREATE SYNONYM syn_p2 FOR p2;
END;
$$
ERROR 2F003: Can't create a SYNONYM from within another stored routine
CREATE FUNCTION f2 RETURN INT AS
BEGIN
CREATE SYNONYM syn_p2 FOR p2;
RETURN 1;
END;
$$
ERROR 2F003: Can't create a SYNONYM from within another stored routine
CREATE PACKAGE pkg2 AS
FUNCTION f1 RETURN INT;
END;
$$
CREATE PACKAGE BODY pkg2 AS
FUNCTION f1 RETURN INT AS
BEGIN
CREATE SYNONYM syn_p2 FOR p2;
RETURN 1;
END;
END;
$$

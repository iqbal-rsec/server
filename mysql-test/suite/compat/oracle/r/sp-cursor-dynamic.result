#
# Dynamic query re-OPEN after CLOSE
#
DECLARE
c0 sys_refcursor;
v INTEGER;
q1 VARCHAR2(64):= 'SELECT a FROM t1';
q2 VARCHAR2(64):= 'SELECT a + 1 FROM t1';
BEGIN
OPEN c0 FOR q1;
FETCH c0 INTO v;
SELECT v;
CLOSE c0;
OPEN c0 FOR q2;
FETCH c0 INTO v;
SELECT v;
CLOSE c0;
END;
$$
v
1

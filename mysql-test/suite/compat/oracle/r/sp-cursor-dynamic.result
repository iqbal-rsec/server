#
# Two cursors with dynamic query in stored FUNCTION
#
CREATE OR REPLACE FUNCTION f2(a INT) RETURN INTEGER
AS
c0, c1 sys_refcursor;
v0, v1 INTEGER;
BEGIN
OPEN c0 FOR CONCAT('SELECT t1.a FROM t1 WHERE t1.a = ', a);
FETCH c0 INTO v0;
OPEN c1 FOR CONCAT('SELECT t1.a FROM t1 WHERE t1.a = ', a + 1);
FETCH c1 INTO v1;
CLOSE c0;
CLOSE c1;
RETURN v0 + v1;
END;
$$
SELECT f2(1) AS v1, f2(2) AS v2;
v1	v2
3	5
#
# Dynamic query in stored FUNCTION calling a stored FUNCTION
#
CREATE OR REPLACE FUNCTION f2(a INT) RETURN TEXT
AS
c0 sys_refcursor;
v TEXT;
BEGIN
OPEN c0 FOR f1(a);
FETCH c0 INTO v;
CLOSE c0;
RETURN v;
END;
$$
SELECT f2(1) AS v1, f2(2) AS v2;
v1	v2
1	2
SHOW FUNCTION CODE f2;
Pos	Instruction
0	set c0@1 NULL
1	set v@2 NULL
2	set tmp_rval@3 "f1"(a@0)
3	copen STMT.cursor[c0@1] tmp_rval@3
4	cfetch STMT.cursor[c0@1] v@2
5	cclose STMT.cursor[c0@1]
6	freturn blob v@2
DROP FUNCTION f2;
#
# Dynamic query in stored PROCEDURE
#
CREATE OR REPLACE PROCEDURE p1(a INT)
AS
c0 sys_refcursor;
v INTEGER;
BEGIN
OPEN c0 FOR CONCAT('SELECT a FROM t1 WHERE a = ', a);
FETCH c0 INTO v;
CLOSE c0;
SELECT v;
END;
$$
CALL p1(1);
v
1
SHOW PROCEDURE CODE p1;
Pos	Instruction
0	set c0@1 NULL
1	set v@2 NULL
2	set tmp_rval@3 concat('SELECT a FROM t1 WHERE a = ',a@0)
3	copen STMT.cursor[c0@1] tmp_rval@3
4	cfetch STMT.cursor[c0@1] v@2
5	cclose STMT.cursor[c0@1]
6	stmt 0 "SELECT v"
7	destruct sys_refcursor c0@1
DROP PROCEDURE p1;
#
# Dynamic query in PACKAGE
#
CREATE OR REPLACE PACKAGE pkg1 AS
FUNCTION f1(a INT) RETURN INTEGER;
PROCEDURE p1(a INT);
END;
$$
CREATE OR REPLACE PACKAGE BODY pkg1 AS
FUNCTION f1(a INT) RETURN INTEGER IS
c0 sys_refcursor;
v INTEGER;
BEGIN
OPEN c0 FOR CONCAT('SELECT a FROM t1 WHERE a = ', a);
FETCH c0 INTO v;
CLOSE c0;
RETURN v;
END;
PROCEDURE p1(a INT) IS
c0 sys_refcursor;
v INTEGER;
BEGIN
OPEN c0 FOR CONCAT('SELECT a FROM t1 WHERE a = ', a);
FETCH c0 INTO v;
CLOSE c0;
SELECT v;
END;
END;
$$

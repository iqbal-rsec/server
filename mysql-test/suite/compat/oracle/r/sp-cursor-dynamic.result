#
# Dynamic query stored in SP-variable
#
DECLARE
c0 sys_refcursor;
q VARCHAR2(64):= 'SELECT 10';
v INTEGER;
BEGIN
OPEN c0 FOR q;
FETCH c0 INTO v;
SELECT v;
CLOSE c0;
END;
$$
v
10

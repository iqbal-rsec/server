#
# Dynamic query in stored FUNCTION
#
CREATE OR REPLACE FUNCTION f2(a INT) RETURN INTEGER
AS
c0 sys_refcursor;
v INTEGER;
BEGIN
OPEN c0 FOR CONCAT('SELECT 10 * ', a, ' + SUM(a) FROM t1');
FETCH c0 INTO v;
CLOSE c0;
RETURN v;
END;
$$
